      "boundElements": [],
      "updated": 1785419821070,
      "link": null,
      "locked": false,
      "text": "BIG O\n\nO (n!)        fatorial------> maior complexidade\nO (n^x)       exponencial\nO (log n+n)   \nO (n)         linear\nO (log n)     logaritmica ----> menor complexidade",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BIG O\n\nO (n!)        fatorial------> maior complexidade\nO (n^x)       exponencial\nO (log n+n)   \nO (n)         linear\nO (log n)     logaritmica ----> menor complexidade",
      "autoResize": true,
      "lineHeight": 1.25
    },
